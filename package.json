{
  "name": "@snow-the/dsh-notemap",
  "version": "0.1.0",
  "description": "Networked knowledge graph for DeepSeek Harness: infinite canvas of notes with quantified relations (weights/confidence), graph algorithms (BFS/DFS/Dijkstra/centrality/common-neighbors/PageRank), DuckLake-inspired snapshots + change streams, cytoscape-compatible JSON export.",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "graph", "notebook", "knowledge", "notemap", "deepseek-harness"],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/* --log-level=warning",
    "test": "node --test"
  },
  "files": ["dist", "cordis.patch.yml", "LICENSE", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "repository": { "type": "git", "url": "https://github.com/snow-The/dsh-notemap.git" },
  "types": "./dist/index.d.ts",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}